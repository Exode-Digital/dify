# Patched for Dokploy: internal aliases to avoid dokploy-network name collision.

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $dify_api    dify-api-internal:5001;
    set $dify_web    dify-web-internal:3000;
    set $dify_plugin dify-plugin-internal:5002;

    location /console/api { proxy_pass http://$dify_api; include proxy.conf; }
    location /api         { proxy_pass http://$dify_api; include proxy.conf; }
    location /v1          { proxy_pass http://$dify_api; include proxy.conf; }
    location /openapi     { proxy_pass http://$dify_api; include proxy.conf; }
    location /files       { proxy_pass http://$dify_api; include proxy.conf; }
    location /mcp         { proxy_pass http://$dify_api; include proxy.conf; }
    location /triggers    { proxy_pass http://$dify_api; include proxy.conf; }
    location /explore     { proxy_pass http://$dify_web; include proxy.conf; }

    location /e/ {
      proxy_pass http://$dify_plugin;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    location /socket.io/ {
      set $socket_io_upstream ${NGINX_SOCKET_IO_UPSTREAM};
      proxy_pass http://$socket_io_upstream;
      include proxy.conf;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_cache_bypass $http_upgrade;
    }

    location / { proxy_pass http://$dify_web; include proxy.conf; }

    # placeholder for acme challenge location
    ${ACME_CHALLENGE_LOCATION}

    # placeholder for https config defined in https.conf.template
    ${HTTPS_CONFIG}
}
